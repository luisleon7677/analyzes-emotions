[Unit]
Description=Emotion Analyzer API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/emotion-analyzer
EnvironmentFile=/etc/emotion-analyzer/emotion-analyzer.env
ExecStart=/var/www/emotion-analyzer/venv/bin/python api.py
Restart=always
RestartSec=5
TimeoutStartSec=900

# El modelo y los hilos de descarga/analisis viven dentro de esta API.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
