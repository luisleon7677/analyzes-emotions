# Entorno virtual (se crea en cada máquina)
venv/
.venv/
env/

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Modelos descargados localmente (se obtienen de Hugging Face al ejecutar)
models/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors

# Caché de Hugging Face (no subir; se regenera)
.cache/
huggingface/

# Audios de usuario / pruebas locales (no subir a producción)
audio/*
!audio/.gitkeep

# IDE y sistema operativo
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs y salidas temporales
*.log
logs/
tmp/
temp/

# Empaquetado / distribución
build/
dist/
*.egg-info/
.eggs/

# Tests y cobertura
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
