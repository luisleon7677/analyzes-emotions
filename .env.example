# Copia este archivo como .env para desarrollo local o como:
# /etc/emotion-analyzer/emotion-analyzer.env en EC2.
#
# Carpeta local del modelo. En produccion se recomienda fijarla.
# Debe contener model.safetensors.
MODEL_DIR=/var/www/emotion-analyzer/models/w2v-bert-emotion-es
HOST=0.0.0.0
PORT=8000

# Cola en memoria. Un solo proceso de uvicorn: la cola no se comparte entre procesos.
MAX_QUEUE_SIZE=8
JOB_WAIT_TIMEOUT=900
JOB_TTL_SECONDS=3600
MAX_UPLOAD_MB=150

# Opcional. Si lo configuras, POST /analyze y GET /jobs/{job_id}
# requieren el header: X-API-Key: este_valor
# API_TOKEN=

# Para URLs s3://bucket/key usa un rol IAM en la instancia con s3:GetObject.
# Para URLs https presignadas no hace falta credencial AWS en el servidor.
